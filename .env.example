# Google Gemini API Key
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Port for the Express server
PORT=3000

# Escalation webhook URL — your authorized backend/emergency endpoint
# The AI will POST high-risk incidents here. It will NOT contact authorities directly.
ESCALATION_WEBHOOK_URL=https://your-backend.com/escalate

# Optional: Minimum confidence threshold to trigger escalation (default: 0.85)
ESCALATION_CONFIDENCE_THRESHOLD=0.85
